# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Environments / secrets -------------------------------------------------
.env
.env.*
!.env.example

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- uv ---------------------------------------------------------------------
# uv.lock IS committed; the cache is not.
.uv/

# --- Data (raw vendor responses and derived artefacts are not versioned) ----
data/raw/
data/features/
*.db
*.sqlite
*.sqlite3
*.parquet
!data/raw/reference/.gitkeep

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- Frontend (Next.js / Streamlit) -----------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
# Generated by `next build`/`next dev` on first run; regenerated, never edited.
frontend/next-env.d.ts
# frontend/src/lib/api/ is NOT ignored. It holds hand-written source (client.ts,
# contract.test-d.ts) alongside a committed snapshot of the generated schema.
# The snapshot is the point: tests/api/test_client_generation.py diffs it against
# the running app, so a route added without regenerating the client fails CI. An
# uncommitted snapshot has nothing to diff against.

# --- OS / editors -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
