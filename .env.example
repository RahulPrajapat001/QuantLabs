# QuantLab environment configuration.
# Copy to `.env` and adjust. All variables are prefixed QUANTLAB_.
# No real credentials belong in this file or in `.env` committed to git.

# --- Storage ----------------------------------------------------------------
QUANTLAB_DATA_DIR=data
QUANTLAB_RAW_DIR=data/raw
QUANTLAB_FEATURES_DIR=data/features

# SQLite in development; PostgreSQL in production (M4).
#   sqlite:///quantlab.db
#   postgresql+psycopg://quantlab:quantlab@localhost:5432/quantlab
# Both are exercised by tests/db/test_migrations.py and by CI. Install the driver
# with the `postgres` extra: pip install -e ".[postgres]"
QUANTLAB_DATABASE_URL=sqlite:///quantlab.db

# Pre-registration document: hypotheses written down before they are tested.
QUANTLAB_HYPOTHESES_FILE=docs/hypotheses.md

# --- Observability ----------------------------------------------------------
# Logs are structured. JSON when stderr is not a TTY (containers, CI), a readable
# console renderer otherwise. Every line emitted while handling a request carries
# the request_id, which is also returned as the X-Request-ID response header.
QUANTLAB_LOG_LEVEL=INFO

# --- Data provider credentials (leave blank; set locally, never commit) -----
QUANTLAB_ALPHA_VANTAGE_API_KEY=
QUANTLAB_POLYGON_API_KEY=

# NOTE: QUANTLAB_UNLOCK_HOLDOUT is deliberately NOT listed here. The 2024-01-01+
# holdout is locked. Unlocking it requires consciously exporting
# QUANTLAB_UNLOCK_HOLDOUT=1 in your shell AND constructing the DataHandler with
# holdout=True. See CLAUDE.md §3 and docs/PRD.md §4.2.
